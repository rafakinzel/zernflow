# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Late API key and AI Gateway key are set per-workspace in Settings UI.
# For self-hosted, you can optionally set AI_GATEWAY_API_KEY as a fallback.

# AI Gateway (for AI Response flow node, optional for self-hosted)
# On Vercel: configure provider keys in AI Gateway settings (automatic OIDC auth)
# Self-hosted: set this key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=your-gateway-key

# Cron secret (for sequence processor + job scheduler)
CRON_SECRET=your-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Central TB door (app/api/v1/central). 32+ chars, e.g. `openssl rand -hex 32`.
# Unset means the door refuses everyone. See docs/CENTRAL-PASSO-A-PASSO.md.
# CENTRAL_AGENT_KEY=
# Only needed if there is more than one workspace.
# CENTRAL_AGENT_WORKSPACE_ID=
